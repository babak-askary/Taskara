PORT=5001
DATABASE_URL=postgresql://user:password@host:5432/taskara
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_here
AUTH0_AUDIENCE=https://taskara-api
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
NODE_ENV=development

# Cloudinary — file attachment storage (free tier; no card required)
# Sign up at https://cloudinary.com and copy these from the dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hugging Face — free AI inference for the assistant
# Token from https://huggingface.co/settings/tokens (Read scope)
# Optional override: HUGGINGFACE_MODEL (default meta-llama/Llama-3.1-8B-Instruct)
HUGGINGFACE_API_KEY=
